# The transition, its non-delivery report (.failed), and the .arming.<pid> temp
# the atomic state rewrite lands beside it. One transition file, because at most
# one can be in flight; it carries its own state in line 1 and exists for part
# of one turn (or one turn end -> transition window) before a hook consumes it.
.claude/autodrive*

# The checkpoint's IPC to gitlore, written on the memory directive's
# instruction and consumed by gitlore's own hooks. Listed because a `git add
# -A` in the same turn races the consumer and commits a spent trigger.
# `.claude/gitlore-hook-setup` is deliberately NOT here — that one is gitlore's
# tracked install state, not IPC.
.claude/gitlore-memory-message
.claude/gitlore-commit-memory

# Local-only Claude Code settings
.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc

# uv-managed venv (created by `uv sync`; uv.lock IS tracked)
.venv/
.pytest_cache/

# macOS Finder metadata and AppleDouble sidecars. Several had accumulated
# under docs/ and got carried along by directory moves.
.DS_Store
._*

/dist/plugin/
