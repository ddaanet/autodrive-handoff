source_up_if_exists
PATH_add .gitlore/bin

# Activate the uv-managed venv (created by `uv sync`) without `uv run`:
# export VIRTUAL_ENV and prepend its bin to PATH so bare `pytest` resolves.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# Vendored dogfood `claude` shim: loads the copy `just dogfood` syncs into
# dist/plugin/. Last PATH_add wins, keeping it ahead of .gitlore/bin.
PATH_add plugin-dev/bin
