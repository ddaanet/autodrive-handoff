{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/plugin-dev/version-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/plugin-dev/dogfood.sh\" pre-tool"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/plugin-dev/dogfood.sh\" session-start"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "gitlore@ddaanet": true,
    "plugin-dev@claude-plugins-official": true,
    "shell-scripting@ddaanet": true
  },
  "gitlore": {
    "enabled": true,
    "precommitCommand": "just precommit"
  }
}
