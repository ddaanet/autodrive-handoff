#!/usr/bin/env bash
# PATH-resident entry point for the checkpoint channel. Claude Code adds
# every installed plugin's bin/ to PATH, so the skill body can invoke this by
# bare name. Self-locates and execs the real logic in scripts/ (Python). Replaces
# bin/handoff-memory-probe and bin/handoff-precompact-probe.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
exec python3 "$here/../scripts/checkpoint.py" "$@"
