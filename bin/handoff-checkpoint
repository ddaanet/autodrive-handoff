#!/usr/bin/env bash
# PATH-resident entry point for the checkpoint channel. Claude Code adds
# every installed plugin's bin/ to PATH, so the skill body can invoke this by
# bare name. Self-locates and execs the real logic in scripts/ (Python — see
# the changelog-archive tag's 2026-08-10 record, "checkpoint.sh and the watcher move to Python"). Replaces bin/handoff-memory-probe
# and bin/handoff-precompact-probe.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
exec python3 "$here/../scripts/checkpoint.py" "$@"
